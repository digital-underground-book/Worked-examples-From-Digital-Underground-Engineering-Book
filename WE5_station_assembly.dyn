    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "// the shaft sits at the end of its passage, half the passage length from the alignment,\n// its width runs along the alignment and its length away from it\nx0 = (ch[pIdx] - Ws/2)*k;\nx1 = (ch[pIdx] + Ws/2)*k;\nyA = side*Lp/2*k;\nyB = side*(Lp/2 + Ls)*k;\ny0 = Math.Min(yA, yB);\ny1 = Math.Max(yA, yB);\n// outer box minus inner box gives the walls, the inner box is taller so the top is open\nlo = Point.ByCoordinates(x0, y0, 0);\nhi = Point.ByCoordinates(x1, y1, hs*k);\nouter = Cuboid.ByCorners(lo, hi);\nloIn = Point.ByCoordinates(x0 + t*k, y0 + t*k, -k);\nhiIn = Point.ByCoordinates(x1 - t*k, y1 - t*k, hs*k + k);\ninner = Cuboid.ByCorners(loIn, hiIn);\nwalls = Solid.Difference(outer, inner);\n// base slab under the whole footprint\nloB = Point.ByCoordinates(x0, y0, -t*k);\nhiB = Point.ByCoordinates(x1, y1, 0);\nbase = Cuboid.ByCorners(loB, hiB);",
      "Id": "ba61dfa432bb46a0889ca73c02d725a9",
      "Inputs": [
        {
          "Id": "1d5109f5bca54ef397a7343f95fb410b",
          "Name": "ch",
          "Description": "ch",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
