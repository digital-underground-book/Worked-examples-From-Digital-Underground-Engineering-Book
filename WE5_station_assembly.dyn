          "Description": "Ls",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "62102364736d472583a91f1342656443",
          "Name": "",
          "Description": "Ws",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f63ae8ce59184feab6b7fcb947b24d9b",
          "Name": "",
          "Description": "hs",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "// Dynamo works in the length unit of the Revit project.\n// For a metric project in millimetres, k = 1000 converts metres to millimetres.\nk = 1000;",
      "Id": "7afe76f66beb40779e4fc7eb528933a1",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "072fbb25a7d34af7a156d30709b26414",
          "Name": "",
          "Description": "k",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "ch = [P1, P2, P3];\npEnd = Point.ByCoordinates(Lc*k, 0, 0);\nalign = Line.ByStartPointEndPoint(Point.Origin(), pEnd);\npA = Point.ByCoordinates(ch*k, -Lp/2*k, 0);\npB = Point.ByCoordinates(ch*k, Lp/2*k, 0);\npassage = Line.ByStartPointEndPoint(pA, pB);",
      "Id": "d5cd3f3cb05e4c6588c1d2aefb62e978",
      "Inputs": [
        {
