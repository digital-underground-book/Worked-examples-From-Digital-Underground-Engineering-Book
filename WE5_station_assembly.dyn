    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "cat = Revit.Elements.Category.ByName(\"Generic Models\");\nmat = Revit.Elements.DirectShape.DynamoPreviewMaterial;\ndsWalls = Revit.Elements.DirectShape.ByGeometry(walls, cat, mat, \"Shaft walls\");\ndsBase = Revit.Elements.DirectShape.ByGeometry(base, cat, mat, \"Shaft base\");\ndsAdit = Revit.Elements.DirectShape.ByGeometry(adit, cat, mat, \"Cross-passage\");\ndsRuns = Revit.Elements.DirectShape.ByGeometry(runs, cat, mat, \"Cavern run\");",
      "Id": "4fe4ae5a62cc42b09ffc551e7adc4002",
