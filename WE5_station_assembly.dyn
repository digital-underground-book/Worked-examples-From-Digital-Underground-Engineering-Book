    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "// one entry per shaft: passage (0 = P1, 1 = P2, 2 = P3),\n// side (+1 west, -1 east), length, width and height (m)\npIdx = [0, 0, 1, 2];\nside = [1, -1, 1, 1];\nLs = [32, 40, 32, 50];\nWs = [10, 10, 10, 15];\nhs = [30, 30, 30, 30];",
      "Id": "0cbecb32347146f5b08c758b60bae5ae",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "3a1dca7affdc451883965b5b5b0b9d57",
          "Name": "",
          "Description": "pIdx",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
