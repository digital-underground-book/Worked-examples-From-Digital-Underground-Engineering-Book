    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "// the cavern is broken at the three passages into four runs\nbrk = [0, P1, P2, P3, Lc];\ns0 = brk[0..3];\nrunLen = brk[1..4] - s0;\nwc = 15;\nhc = 7;\nr1 = Point.ByCoordinates(0, -wc/2*k, 0);\nr2 = Point.ByCoordinates(0, wc/2*k, 0);\nr3 = Point.ByCoordinates(0, wc/2*k, hc*k);\nr4 = Point.ByCoordinates(0, 0, (hc + wc/2)*k);\nr5 = Point.ByCoordinates(0, -wc/2*k, hc*k);\ncedges = [Line.ByStartPointEndPoint(r1, r2),\n          Line.ByStartPointEndPoint(r2, r3),\n          Arc.ByThreePoints(r3, r4, r5),\n          Line.ByStartPointEndPoint(r5, r1)];\ncprof = PolyCurve.ByJoinedCurves(cedges);\nruns = cprof.Translate(s0*k, 0, 0).ExtrudeAsSolid(Vector.XAxis(), runLen*k);",
      "Id": "39315390dd514221bbea5263fcd5bf43",
      "Inputs": [
        {
          "Id": "75e4c4124dd241cb82f112e5cffee028",
          "Name": "P1",
