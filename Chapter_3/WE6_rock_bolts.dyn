          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "// (u+1) x (v+1) grid: equal arc length around the crown, equal spacing along the run\nlens = 0..crown.Length..#(nu + 1);\nys = 0..L*k..#(v + 1);\npc = crown.PointAtSegmentLength(lens);\nxs = pc.X;\nzs = pc.Z;\np1 = Flatten(Point.ByCoordinates(xs<1>, ys<2>, zs<1>));\np2 = p1.Translate(srf.NormalAtPoint(p1), sgn*lb*k);\nbolts = Line.ByStartPointEndPoint(p1, p2);\nrods = Cylinder.ByPointsRadius(p1, p2, d/2*k);",
      "Id": "d28d8033e03b4651a21f849e56e98d3a",
      "Inputs": [
        {
          "Id": "1c795f43946b4cc0b51d71d809c4d274",
          "Name": "crown",
          "Description": "crown",
          "UsingDefaultValue": false,
