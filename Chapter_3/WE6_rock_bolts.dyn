      "Description": "Allows for DesignScript code to be authored directly"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "srf = crown.Extrude(Vector.YAxis(), L*k);\nsgn = srf.NormalAtParameter(0.5, 0.5).Z > 0 ? 1 : -1;\nlining = srf.Thicken(-sgn*tl*k, false);\nouter = srf.Offset(sgn*lb*k);",
      "Id": "2cd93963f61849afbaf332b7814a1084",
      "Inputs": [
        {
          "Id": "93c567c746e9429e9cf59e82ae59b927",
          "Name": "crown",
          "Description": "crown",
          "UsingDefaultValue": false,
          "Level": 2,
