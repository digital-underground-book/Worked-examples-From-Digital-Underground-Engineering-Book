    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "// Dynamo works in the length unit of the Revit project (k = 1000 for millimetres)\nk = 1000;",
      "Id": "09047358a3cf4803b8af341a64383875",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "15cf1eb60bc84f8c91acb609af41b645",
          "Name": "",
          "Description": "k",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "// half-crown of the five-arc profile: crown arc R1 over A1, then shoulder arc R2 over A2,\n// tangent at their junction (Math.Sin and Math.Cos take degrees)\nc2x = (R1 - R2)*Math.Sin(A1);\nc2z = -R1 + (R1 - R2)*Math.Cos(A1);\n// a point on an arc = centre + R*(sin a, cos a), the angle a measured from the vertical\nc1 = Point.ByCoordinates(0, 0, -R1*k);\nc2 = Point.ByCoordinates(c2x*k, 0, c2z*k);\na0 = c1.Translate(0, 0, R1*k);\nam = c1.Translate(R1*Math.Sin(A1/2)*k, 0, R1*Math.Cos(A1/2)*k);\na1 = c1.Translate(R1*Math.Sin(A1)*k, 0, R1*Math.Cos(A1)*k);\nbm = c2.Translate(R2*Math.Sin(A1 + A2/2)*k, 0, R2*Math.Cos(A1 + A2/2)*k);\nb1 = c2.Translate(R2*Math.Sin(A1 + A2)*k, 0, R2*Math.Cos(A1 + A2)*k);\ncrown = PolyCurve.ByJoinedCurves([Arc.ByThreePoints(a0, am, a1), Arc.ByThreePoints(a1, bm, b1)]);\narcLen = crown.Length/k;",
      "Id": "4820f781bb8142ae8f7bf526781113f3",
      "Inputs": [
        {
          "Id": "197a116f652d42b69d0323ea27317ecd",
          "Name": "R1",
          "Description": "R1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ef944473b67d4d3cae306b529b944d02",
          "Name": "R2",
          "Description": "R2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "64018700a25b4251b195836e775e4304",
          "Name": "A1",
          "Description": "A1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "829b6f5441ae44f88394bcded263783c",
          "Name": "k",
