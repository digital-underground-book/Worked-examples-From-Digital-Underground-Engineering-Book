    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "nBolts = List.Count(bolts);\nsLong = L/v;\nsRad = arcLen/nu;\nlTotal = nBolts*lb;",
      "Id": "b47d83de29004d5eb91e4d007578510b",
