          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1d96c2f89d564ea3ba2e953e11dbaec5",
          "Name": "",
          "Description": "outer",
          "UsingDefaultValue": false,
          "Level": 2,
