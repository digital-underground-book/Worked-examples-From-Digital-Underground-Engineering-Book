        {
          "Id": "030e828cd69e46208774bcf80b9691de",
          "Name": "",
          "Description": "crown",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
